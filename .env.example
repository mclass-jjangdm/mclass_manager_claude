# ==============================================
# MClass Manager 환경변수 설정
# ==============================================
# 이 파일을 .env로 복사하여 실제 값으로 변경하세요

# Django Settings
# DEBUG는 프로덕션에서 반드시 False로 설정
DEBUG=True

# SECRET_KEY는 프로덕션에서 반드시 새로 생성해서 사용
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-new-one-for-production

# 프로덕션 설정 모듈 (카페24 배포 시)
# DJANGO_SETTINGS_MODULE=mclass_manager.settings_production

# Database Settings
DB_NAME=mclass_manager_db
DB_USER=root
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=3306

# Application Settings
# 프로덕션에서는 실제 도메인으로 변경
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================
# 카페24 가상 호스팅 배포 시 설정
# ==============================================
# ALLOWED_HOSTS=mclass.co.kr,www.mclass.co.kr,teacher.mclass.co.kr,parents.mclass.co.kr,사용자ID.cafe24.com
# CSRF_TRUSTED_ORIGINS=https://mclass.co.kr,https://www.mclass.co.kr,https://teacher.mclass.co.kr,https://parents.mclass.co.kr
# DB_NAME=사용자ID
# DB_USER=사용자ID

# Email Settings (선택사항)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-email@gmail.com

# SMS API Settings (Aligo)
# SMS_API_KEY=your-aligo-api-key
# SMS_USER_ID=your-aligo-user-id
# SMS_SENDER_NUMBER=your-registered-phone-number

# Google Drive API (선택사항)
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/credentials/google_service_account.json
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
